{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zaga Code Settings",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "http://localhost:2025/settings.schema.json"
    },
    "connection": {
      "description": "Model provider connection settings.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "openai"
            },
            "apiKey": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          },
          "required": ["provider", "apiKey", "model"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "lm-studio"
            },
            "model": {
              "type": "string"
            },
            "apiBase": {
              "type": "string"
            }
          },
          "required": ["provider", "model", "apiBase"],
          "additionalProperties": false
        }
      ]
    },
    "theme": {
      "type": "string",
      "enum": ["system", "light", "dark"],
      "description": "UI theme preference. Use 'system' to follow the operating system."
    },
    "mcpServers": {
      "type": "object",
      "description": "A map of MCP server configurations keyed by a server name.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "transport": {
                "type": "string",
                "const": "http"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["transport", "url"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "transport": {
                "type": "string",
                "const": "stdio"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": ["transport", "command"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["mcpServers"],
  "additionalProperties": false
}
