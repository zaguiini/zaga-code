{
  "name": "@zaga/agent",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "exports": {
    "./setup": {
      "development": "./src/setup.ts",
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    },
    "./graphs/agent": {
      "development": "./src/graphs/agent.ts",
      "types": "./dist/graphs/agent.d.ts",
      "default": "./dist/graphs/agent.js"
    },
    "./server": {
      "development": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server/router": {
      "development": "./src/server/router/index.ts",
      "types": "./dist/server/router/index.d.ts",
      "default": "./dist/server/router/index.js"
    },
    "./settings": {
      "development": "./src/settings.ts",
      "types": "./dist/settings.d.ts",
      "default": "./dist/settings.js"
    },
    "./constants": {
      "development": "./src/utils/constants.ts",
      "types": "./dist/utils/constants.d.ts",
      "default": "./dist/utils/constants.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "postbuild": "cp -rf src/agents dist",
    "dev": "tsx --watch src/server/start.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@langchain/classic": "^1.0.27",
    "@langchain/core": "^1.1.38",
    "@langchain/langgraph": "^1.2.6",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@langchain/langgraph-cli": "^1.1.17",
    "@langchain/langgraph-sdk": "^1.8.7",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.4.1",
    "@lmstudio/sdk": "^1.5.0",
    "@trpc/server": "^11.13.0",
    "better-sqlite3": "^12.8.0",
    "fuse.js": "^7.3.0",
    "glob": "^13.0.0",
    "gray-matter": "^4.0.3",
    "langchain": "^1.2.39",
    "langfuse": "^3.38.20",
    "langfuse-langchain": "^3.38.20",
    "superjson": "^2.2.6",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
